# Copie este arquivo para .env e preencha os valores reais
# O .env NUNCA vai para o repositório (está no .gitignore)

# Chave da API Anthropic — obtenha em console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Token da brapi.dev — obtenha em brapi.dev (usado na Fase 1 como primário de produção)
# Deixe vazio durante a validação em modo yfinance (Fase 0-1)
BRAPI_TOKEN=

# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_URL=sqlite:///data/carteira.db

# Modelo Claude (não alterar sem combinar — PLANO §5)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Teto de iterações do loop do agente
AGENT_MAX_ITERS=6

# TTL do cache de cotações em segundos (padrão: 15 min)
QUOTE_CACHE_TTL_SECONDS=900

# Provider de renda variável: "yfinance" (local) ou "brapi" (produção)
PRICE_PROVIDER=yfinance

# Ambiente: "development" ou "production".
# Em production o /docs e o /redoc somem e o cookie de sessão exige HTTPS.
ENV=development

# Autenticação — obrigatória em produção (no Fly, entram como secrets).
# Vazio = app aberto, que é o modo local de sempre.
APP_PASSWORD=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
