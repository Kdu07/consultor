# Copie este arquivo para .env e preencha os valores reais
# O .env NUNCA vai para o repositório (está no .gitignore)

# Chave da API Anthropic — obtenha em console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Token da brapi.dev — obtenha em brapi.dev (usado na Fase 1 como primário de produção)
# Deixe vazio durante a validação em modo yfinance (Fase 0-1)
BRAPI_TOKEN=

# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_URL=sqlite:///data/carteira.db

# Modelo Claude (não alterar sem combinar — PLANO §5)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Teto de iterações do loop do agente
AGENT_MAX_ITERS=6

# TTL do cache de cotações em segundos (padrão: 15 min)
QUOTE_CACHE_TTL_SECONDS=900
